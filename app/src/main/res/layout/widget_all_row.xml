<?xml version="1.0" encoding="utf-8"?>
<!-- Satu baris widget "Semua desa": nama desa + Builder, Lab, Builder Base, Star Lab.
     Tiap sel berisi Chronometer (hitung mundur < 24 jam) atau teks ("2h 9j", "bebas", "–"). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ar_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="@color/widget_divider" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="5dp"
        android:paddingBottom="5dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.25"
            android:orientation="vertical"
            android:paddingEnd="4dp">

            <TextView
                android:id="@+id/ar_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Desa"
                android:textColor="@color/widget_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/ar_hall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="TH13 · BH6"
                android:textColor="@color/widget_text2"
                android:textSize="11sp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="20dp"
            android:layout_weight="1">

            <Chronometer
                android:id="@+id/ar_c1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:autoSizeMaxTextSize="12sp"
                android:autoSizeMinTextSize="8sp"
                android:autoSizeStepGranularity="1sp"
                android:autoSizeTextType="uniform"
                android:fontFamily="monospace"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:textColor="@color/widget_text"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/ar_t1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:autoSizeMaxTextSize="12sp"
                android:autoSizeMinTextSize="8sp"
                android:autoSizeStepGranularity="1sp"
                android:autoSizeTextType="uniform"
                android:fontFamily="monospace"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:text="–"
                android:textColor="@color/widget_text"
                android:textStyle="bold" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="20dp"
            android:layout_weight="1">

            <Chronometer
                android:id="@+id/ar_c2"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:autoSizeMaxTextSize="12sp"
                android:autoSizeMinTextSize="8sp"
                android:autoSizeStepGranularity="1sp"
                android:autoSizeTextType="uniform"
                android:fontFamily="monospace"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:textColor="@color/widget_text"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/ar_t2"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:autoSizeMaxTextSize="12sp"
                android:autoSizeMinTextSize="8sp"
                android:autoSizeStepGranularity="1sp"
                android:autoSizeTextType="uniform"
                android:fontFamily="monospace"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:text="–"
                android:textColor="@color/widget_text"
                android:textStyle="bold" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="20dp"
            android:layout_weight="1">

            <Chronometer
                android:id="@+id/ar_c3"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:autoSizeMaxTextSize="12sp"
                android:autoSizeMinTextSize="8sp"
                android:autoSizeStepGranularity="1sp"
                android:autoSizeTextType="uniform"
                android:fontFamily="monospace"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:textColor="@color/widget_text"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/ar_t3"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:autoSizeMaxTextSize="12sp"
                android:autoSizeMinTextSize="8sp"
                android:autoSizeStepGranularity="1sp"
                android:autoSizeTextType="uniform"
                android:fontFamily="monospace"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:text="–"
                android:textColor="@color/widget_text"
                android:textStyle="bold" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="20dp"
            android:layout_weight="1">

            <Chronometer
                android:id="@+id/ar_c4"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:autoSizeMaxTextSize="12sp"
                android:autoSizeMinTextSize="8sp"
                android:autoSizeStepGranularity="1sp"
                android:autoSizeTextType="uniform"
                android:fontFamily="monospace"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:textColor="@color/widget_text"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/ar_t4"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:autoSizeMaxTextSize="12sp"
                android:autoSizeMinTextSize="8sp"
                android:autoSizeStepGranularity="1sp"
                android:autoSizeTextType="uniform"
                android:fontFamily="monospace"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:text="–"
                android:textColor="@color/widget_text"
                android:textStyle="bold" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
