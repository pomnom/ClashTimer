<?xml version="1.0" encoding="utf-8"?>
<!-- Pratinjau widget di daftar widget launcher (data contoh). Dibuat oleh widget_gen.py dari widget_all.xml. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
